# Prova Oral com IA (Groq) -- ver .env.local pros valores reais.
# Gere a chave em console.groq.com/keys. Nunca commitar a chave real.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Limites diários de chamadas (ledger oral_ai_usage) -- opcional, tem default no código.
ORAL_PROVA_LIMITE_DIARIO_USUARIO=50
ORAL_PROVA_LIMITE_DIARIO_GLOBAL=500

# Preços estimados (USD por 1M tokens / por hora de áudio) -- ajustar
# conforme console.groq.com antes de confiar nos números do painel de custo.
GROQ_PRECO_20B_ENTRADA_USD_1M=0.10
GROQ_PRECO_20B_SAIDA_USD_1M=0.50
GROQ_PRECO_120B_ENTRADA_USD_1M=0.15
GROQ_PRECO_120B_SAIDA_USD_1M=0.75
GROQ_PRECO_WHISPER_USD_HORA=0.04

# Biblioteca "Libros y Resúmenes" -- lista/baixa arquivos direto de pastas
# públicas ("Qualquer pessoa com o link") do Google Drive, sem copiar nada
# pro Storage/DB. Gere em console.cloud.google.com/apis/credentials (API Key,
# restrita à Google Drive API). Não precisa de OAuth -- só funciona com
# pastas/arquivos compartilhados publicamente.
GOOGLE_DRIVE_API_KEY=

# Seções de resumos com UPLOAD pela plataforma (admin → Resumos (Drive)).
# Diferente da API Key acima (só LÊ pastas públicas), aqui a plataforma ESCREVE
# no Drive do admin via OAuth (conta Gmail comum, escopo drive.file). Crie um
# "OAuth client ID" do tipo "Web application" em
# console.cloud.google.com/apis/credentials e registre como "Authorized
# redirect URI" tanto o localhost quanto a produção:
#   http://localhost:3000/api/admin/drive/callback
#   https://medclass.com.ar/api/admin/drive/callback
# Publique a tela de consentimento como "Em produção" (senão o acesso expira em
# 7 dias). O redirect_uri é derivado automaticamente da URL do site, não é env.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Push real no celular (Web Push / VAPID). Gere o par de chaves com:
#   npx web-push generate-vapid-keys
# A pública é exposta ao navegador (precisa dela pra assinar); a privada NUNCA
# sai do servidor. VAPID_SUBJECT é um mailto de contato (exigido pelo protocolo).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:medclassunr@gmail.com

# Segredo compartilhado entre o pg_cron do Supabase e a rota /api/push/dispatch.
# Use o MESMO valor aqui e na migration 20261025000100_push_cron.sql.
PUSH_CRON_SECRET=
